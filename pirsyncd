#!/usr/bin/env python3

"""
pirsyncd stands for: Python Inotify Rsync Daemon

This is a small daemon that watches a directory for kernel's inotify events
and then executes an rsync command to synchronize two different directories
(local or remote). This is a poor man's mirroring or an alternative (not so)
real time data replication mechanism.

It needs only python3 (standard library) and rsync. Nothing else.

Copyright (c) Evaggelos Balaskas (2009 - 2026)
Licensed under GNU General Public License, version 2
"""

import argparse
import ctypes
import errno
import logging
import os
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import time

# Version of pirsyncd
VERSION = "2.0.0"

# Default Directories (Source & Destination Folder Paths)
SOURCE_PATH = "/tmp/data/"
DEST_PATH   = "/tmp/data2/"

# rsync variables
RSYNC_PATH = shutil.which("rsync") or "/usr/bin/rsync"
RSYNC_ARGS = ["-azqx", "--delete-after", "--partial", "--safe-links",
              "--timeout=600"]
RSYNC_LOG  = "/tmp/.pirsyncd.log"
DEBUG_LOG  = "/tmp/.pirsyncdebug"

# destination server (rsync over ssh)
DEST_PORT = 22

# This file contains the pid of the running pirsyncd
PIDFILE = "/tmp/.pirsyncd.pid"

# Run rsync when there are no new events for DELAY seconds ...
DELAY = 1.0
# ... but never wait more than MAX_DELAY seconds (busy directories)
MAX_DELAY = 60.0
# If rsync fails, try again after RETRY_DELAY seconds
RETRY_DELAY = 30.0
# Full rsync every INTERVAL seconds, even without events (0 is disabled)
INTERVAL = 0

# rsync exit codes that are fine.
# 24 means "some files vanished before they could be transferred",
# this is normal when files are changing all the time.
RSYNC_OK = (0, 24)

# Linux inotify constants (see: man 7 inotify)
IN_MODIFY      = 0x00000002
IN_ATTRIB      = 0x00000004
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM  = 0x00000040
IN_MOVED_TO    = 0x00000080
IN_CREATE      = 0x00000100
IN_DELETE      = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF   = 0x00000800
IN_Q_OVERFLOW  = 0x00004000
IN_IGNORED     = 0x00008000
IN_ONLYDIR     = 0x01000000
IN_DONT_FOLLOW = 0x02000000
IN_ISDIR       = 0x40000000
IN_CLOEXEC     = 0o2000000

# The inotify events that pirsyncd watches
MASK = IN_MODIFY | IN_ATTRIB | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | \
       IN_CREATE | IN_DELETE | IN_DELETE_SELF | IN_MOVE_SELF | \
       IN_ONLYDIR | IN_DONT_FOLLOW

# Becomes False when we get a stop signal (SIGTERM, SIGINT)
RUNNING = True

# Description message for help
DESC_MSG = """This is a daemon that watches a directory for kernel's inotify \
events and then executes an rsync command to synchronize two different \
directories (local or remote). This is a poor man's mirroring or an \
alternative (not so) real time data replication mechanism."""

