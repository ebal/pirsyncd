class Inotify:
    """ A tiny wrapper around the linux inotify system calls (via ctypes) """

    def __init__(self):
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p,
                                                ctypes.c_uint32]
        self.fd = self.libc.inotify_init1(IN_CLOEXEC)
        if self.fd < 0:
            err = ctypes.get_errno()
            raise OSError(err, "inotify_init1: " + os.strerror(err))
        # watch descriptor -> directory path
        self.watches = {}

    def add_watch(self, path):
        """ Watch a directory (not recursive) """
        wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), MASK)
        if wd < 0:
            err = ctypes.get_errno()
            raise OSError(err, os.strerror(err), path)
        self.watches[wd] = path

    def read_events(self):
        """ Read the waiting events, returns a list of (wd, mask, name) """
        data = os.read(self.fd, 64 * 1024)
        events = []
        offset = 0
        # struct inotify_event { int wd; uint32 mask, cookie, len; char name[]; }
        while offset < len(data):
            wd, mask, _cookie, length = struct.unpack_from("iIII", data, offset)
            offset += 16
            name = data[offset:offset + length].rstrip(b"\0")
            offset += length
            events.append((wd, mask, os.fsdecode(name)))
        return events


def is_excluded(path, options):
    """ True if the path (relative to source) starts with the exclude pattern """
    if not options.EXCLUDE_PAT:
        return False
    relative = os.path.relpath(path, options.SOURCE_PATH)
    return relative.startswith(options.EXCLUDE_PAT.rstrip("*"))


def watch_tree(inotify, top, options):
    """ Watch a directory and all of its sub directories """
    for root, dirs, _files in os.walk(top):
        # do not walk into excluded directories
        dirs[:] = [d for d in dirs
                   if not is_excluded(os.path.join(root, d), options)]
        try:
            inotify.add_watch(root)
        except OSError as err:
            if err.errno == errno.ENOSPC:
                logging.error("No more inotify watches for %s, raise the "
                              "limit: sysctl fs.inotify.max_user_watches",
                              root)
            elif err.errno != errno.ENOENT:
                # ENOENT: directory was removed before we could watch it
                logging.warning("Can not watch %s: %s", root, err)


def handle_events(inotify, options):
    """ Read all waiting events and keep the watches up to date.
        Returns False if the source directory is gone. """
    for wd, mask, name in inotify.read_events():
        if mask & IN_Q_OVERFLOW:
            # The kernel queue was full and we lost events.
            # Not a problem, rsync copies everything, but we may have
            # lost some new directories, so we watch the tree again.
            logging.warning("inotify queue overflow, rescan %s",
                            options.SOURCE_PATH)
            watch_tree(inotify, options.SOURCE_PATH, options)
            continue

        directory = inotify.watches.get(wd)
        if directory is None:
            continue

        if mask & IN_IGNORED:
            # The watched directory was removed
            del inotify.watches[wd]
            if directory == options.SOURCE_PATH:
                return False
            continue

        if mask & IN_MOVE_SELF and directory == options.SOURCE_PATH:
            # The source directory was renamed (moved away)
            return False

        path = os.path.join(directory, name)
        logging.debug("event: 0x%08x %s", mask, path)

        # A new (or moved here) directory needs to be watched too
        if mask & IN_ISDIR and mask & (IN_CREATE | IN_MOVED_TO) \
                and not is_excluded(path, options):
            watch_tree(inotify, path, options)
    return True


def rsync_command(options):
    """ Build the rsync command (as a list, no shell) """
    # Trailing slash (/): sync the content of the source directory
    source = options.SOURCE_PATH.rstrip("/") + "/"
    command = [options.RSYNC_PATH] + RSYNC_ARGS
    if options.EXCLUDE_PAT:
        command.append("--exclude=" + options.EXCLUDE_PAT)
    if options.rsync_append:
        command.append("--append")
    if options.MAX_SIZE:
        command.append("--max-size=" + options.MAX_SIZE)
    if options.MIN_SIZE:
        command.append("--min-size=" + options.MIN_SIZE)
    # rsync version 2 does not support --log-file
    if options.RSYNC_LOG and not options.rsync_v2:
        command.append("--log-file=" + options.RSYNC_LOG)

    if options.DEST_SERVER:
        # rsync over ssh
        command += ["-e", "ssh -p " + str(options.DEST_PORT),
                    source,
                    options.DEST_SERVER + ":" + options.DEST_PATH]
    elif options.RSYNC_DAEMON:
        # rsync against an rsync server (rsync --daemon)
        command += ["--password-file=" + options.RSYNC_PASS_FILE,
                    source, options.RSYNC_DAEMON]
    else:
        # local rsync
        command += [source, options.DEST_PATH]
    return command


def mirror(command):
    """ This is the part that runs rsync. Returns True on success """
    logging.debug("rsync: %s", " ".join(command))
    start = time.monotonic()
    try:
        result = subprocess.run(command, stdin=subprocess.DEVNULL,
                                capture_output=True, text=True)
    except OSError as err:
        logging.error("Can not run rsync: %s", err)
        return False
    seconds = time.monotonic() - start
    if result.returncode in RSYNC_OK:
        logging.info("rsync done in %.2f seconds", seconds)
        return True
    logging.error("rsync failed with exit code %d: %s",
                  result.returncode, result.stderr.strip())
    return False


def watch_loop(inotify, command, options):
    """ The main loop: wait for events and run rsync when it is time """
    pending     = True  # do we need to run rsync? (yes, the first time)
    first_event = 0     # time of the first event, since the last rsync
    last_event  = 0     # time of the last event
    last_sync   = 0     # time of the last good rsync
    retry_at    = 0     # do not run rsync before that time (after an error)

    # How long to wait for new events, before we check the timers again
    tick = min(1.0, max(0.1, options.DELAY))

    while RUNNING:
        now = time.monotonic()

        # Periodic full rsync, even without events
        if options.INTERVAL > 0 and now - last_sync >= options.INTERVAL:
            pending = True

        # Run rsync after a quiet moment, but do not wait for ever
        if pending and now >= retry_at:
            quiet    = now - last_event >= options.DELAY
            too_long = now - first_event >= options.MAX_DELAY
            if quiet or too_long:
                if mirror(command):
                    pending = False
                    last_sync = time.monotonic()
                else:
                    retry_at = time.monotonic() + RETRY_DELAY

        # Wait for new events
        ready, _, _ = select.select([inotify.fd], [], [], tick)
        if ready:
            if not handle_events(inotify, options):
                logging.error("Source directory %s is gone, exit",
                              options.SOURCE_PATH)
                return 1
            now = time.monotonic()
            if not pending:
                pending = True
                first_event = now
            last_event = now

    # We are stopping, do not leave changes behind
    if pending:
        logging.info("Last rsync before exit")
        mirror(command)
    return 0


def read_pid(pidfile):
    """ Returns the pid in the pidfile, or 0 """
    try:
        with open(pidfile) as pfile:
            return int(pfile.read().strip())
    except (OSError, ValueError):
        return 0


def is_running(pid):
    """ True if there is a running process with this pid """
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        # It exists, but it is not ours
        return True
    return True


def remove_pidfile(pidfile):
    """ Remove the pidfile, if it is still there """
    try:
        os.remove(pidfile)
    except FileNotFoundError:
        pass


def my_action(options):
    """ User wants -k stop or -k status. Returns the exit code """
    pid = read_pid(options.PIDFILE)
    if not is_running(pid):
        print("There is no running pirsyncd instance (pidfile: "
              + options.PIDFILE + ")")
        if pid:
            # stale pidfile from a crashed pirsyncd
            remove_pidfile(options.PIDFILE)
        return 1

    if options.ACTION == "status":
        print("There is a running instance of pirsyncd, with PID: " + str(pid))
        return 0

    # stop: ask nicely (SIGTERM), pirsyncd runs a last rsync and exits
    os.kill(pid, signal.SIGTERM)
    for _ in range(600):
        if not is_running(pid):
            print("pirsyncd with PID: " + str(pid) + " stopped successfully")
            return 0
        time.sleep(0.1)
    print("pirsyncd with PID: " + str(pid) + " is still running "
          "(perhaps a long rsync), check again with: -k status")
    return 1


def check_config(options):
    """ Validate the configuration of pirsyncd, returns a list of errors """
    errors = []
    pid = read_pid(options.PIDFILE)
    if is_running(pid):
        errors.append("There is a running pirsyncd instance already, PID: "
                      + str(pid) + " (pidfile: " + options.PIDFILE + ")")
    if not os.path.isdir(options.SOURCE_PATH):
        errors.append("There isn't any (source directory): "
                      + options.SOURCE_PATH)
    if not os.access(options.RSYNC_PATH, os.X_OK):
        errors.append("There isn't any rsync: " + options.RSYNC_PATH)
    if not 0 < options.DEST_PORT < 65536:
        errors.append("ssh port must be between 1 and 65535: "
                      + str(options.DEST_PORT))
    if options.DELAY < 0 or options.MAX_DELAY < 0 or options.INTERVAL < 0:
        errors.append("--delay, --max_delay and --interval can not be negative")

    # Both RSYNC_DAEMON & RSYNC_PASS_FILE arguments must have values.
    if bool(options.RSYNC_DAEMON) != bool(options.RSYNC_PASS_FILE):
        errors.append("--rsync_daemon works only together with "
                      "--rsync_pass_file")

    if options.DEST_SERVER:
        # rsync over ssh, the destination directory is on the remote server
        pass
    elif options.RSYNC_DAEMON:
        # Valid is something like this: [user@]rsync.example.com::data
        if not re.match(r"^([\w.-]+@)?[\w.-]+::[\w.-]+(/.*)?$", options.RSYNC_DAEMON):
            errors.append("rsync_daemon: " + options.RSYNC_DAEMON
                          + ", isnt a valid argument. You must type something "
                          "like this: rsync.example.com::data")
        if options.RSYNC_PASS_FILE and \
                not os.path.isfile(options.RSYNC_PASS_FILE):
            errors.append("There isn't any : " + options.RSYNC_PASS_FILE)
    elif not os.path.isdir(options.DEST_PATH):
        errors.append("There isn't any (destination directory): "
                      + options.DEST_PATH)
    return errors


def getarguments(argv=None):
    """ Getting user arguments """
    parser = argparse.ArgumentParser(prog="pirsyncd", description=DESC_MSG)
    parser.add_argument("-v", "--version",
        action="version",
        version="pirsyncd " + VERSION,
        help="Print version and exit")
    parser.add_argument("-s", "--source",
        dest="SOURCE_PATH",
        default=SOURCE_PATH,
        help="This is the source (watched) directory. (default: %(default)s)")
    parser.add_argument("-d", "--destination",
        dest="DEST_PATH",
        default=DEST_PATH,
        help="This is the destination (to sync) directory. "
             "(default: %(default)s)")
    parser.add_argument("-p", "--pidfile",
        dest="PIDFILE",
        default=PIDFILE,
        help="Full path of file contains the PID of the running instance. "
             "Use a different pidfile for every instance of pirsyncd. "
             "(default: %(default)s)")
    parser.add_argument("-r", "--rsync",
        dest="RSYNC_PATH",
        default=RSYNC_PATH,
        help="Full path of rsync command. (default: %(default)s)")
    parser.add_argument("-l", "--log",
        dest="RSYNC_LOG",
        default=RSYNC_LOG,
        help="Full path of rsync log file. (default: %(default)s)")
    parser.add_argument("--nolog",
        action="store_const",
        const="",
        dest="RSYNC_LOG",
        help="Disable rsync logging")
    parser.add_argument("-f", "--foreground",
        action="store_true",
        dest="FOREGROUND",
        help="Dont put the pirsyncd in background "
             "(logs are also printed on screen)")
    parser.add_argument("--debug",
        dest="DEBUG_LOG",
        default=DEBUG_LOG,
        help="Full path of pirsyncd log file. (default: %(default)s)")
    parser.add_argument("--nodebug",
        action="store_const",
        const="",
        dest="DEBUG_LOG",
        help="Disable the pirsyncd log file")
    parser.add_argument("--verbose",
        action="store_true",
        help="Log every inotify event (can be a lot!)")
    parser.add_argument("--rsync_append",
        action="store_true",
        help="Enable rsync append functionality")
    parser.add_argument("--rsync_v2",
        action="store_true",
        help="Disable rsync version 3 functionality (eg. log-file)")
    parser.add_argument("--host",
        dest="DEST_SERVER",
        default="",
        help="Enable rsync over ssh. You must define a destination server "
             "with passwordless (ssh key) connection.")
    parser.add_argument("--port",
        dest="DEST_PORT",
        type=int,
        default=DEST_PORT,
        help="Define the destination ssh port, only with --host "
             "(default: %(default)s)")
    parser.add_argument("--rsync_daemon",
        dest="RSYNC_DAEMON",
        default="",
        help="Enable rsync over native rsync protocol. Valid argument is of "
             "form host::module. If --host is set, then --rsync_daemon is "
             "disabled.")
    parser.add_argument("--rsync_pass_file",
        dest="RSYNC_PASS_FILE",
        default="",
        help="Name of password file to be used in combination with rsync "
             "daemon mode (--rsync_daemon).")
    parser.add_argument("--max_size",
        dest="MAX_SIZE",
        default="",
        help="Exclude files larger than this size from synchronization.")
    parser.add_argument("--min_size",
        dest="MIN_SIZE",
        default="",
        help="Exclude files smaller than this size from synchronization.")
    parser.add_argument("--exclude_pattern",
        dest="EXCLUDE_PAT",
        default="",
        help="Exclude pattern from rsync and inotify watch.")
    parser.add_argument("--delay",
        dest="DELAY",
        type=float,
        default=DELAY,
        help="Run rsync after DELAY seconds without new events. "
             "(default: %(default)s)")
    parser.add_argument("--max_delay",
        dest="MAX_DELAY",
        type=float,
        default=MAX_DELAY,
        help="Run rsync at least every MAX_DELAY seconds while events keep "
             "coming. (default: %(default)s)")
    parser.add_argument("--interval",
        dest="INTERVAL",
        type=float,
        default=INTERVAL,
        help="Run a full rsync every INTERVAL seconds, even without events. "
             "0 is disabled. (default: %(default)s)")
    parser.add_argument("--examples",
        action="store_true",
        help="Print a list of pirsyncd usage examples and exit")
    parser.add_argument("-k",
        dest="ACTION",
        choices=["stop", "status"],
        help="With -k stop you stop the pirsyncd. "
             "With -k status you can check the status of pirsyncd.")
    return parser.parse_args(argv)


def fix_paths(options):
    """ Use full paths, because the daemon runs from / """
    options.SOURCE_PATH = os.path.abspath(options.SOURCE_PATH)
    options.PIDFILE = os.path.abspath(options.PIDFILE)
    if options.RSYNC_LOG:
        options.RSYNC_LOG = os.path.abspath(options.RSYNC_LOG)
    if options.DEBUG_LOG:
        options.DEBUG_LOG = os.path.abspath(options.DEBUG_LOG)
    if options.RSYNC_PASS_FILE:
        options.RSYNC_PASS_FILE = os.path.abspath(options.RSYNC_PASS_FILE)
    # the destination can be on a remote server, use it as it is
    if not options.DEST_SERVER and not options.RSYNC_DAEMON:
        options.DEST_PATH = os.path.abspath(options.DEST_PATH)
    if not options.DEST_PATH.endswith("/"):
        options.DEST_PATH += "/"


def setup_logging(options):
    """ Log to the debug log file and, in foreground, also on screen """
    handlers = []
    if options.DEBUG_LOG:
        handlers.append(logging.FileHandler(options.DEBUG_LOG))
    if options.FOREGROUND:
        handlers.append(logging.StreamHandler())
    if not handlers:
        handlers.append(logging.NullHandler())
    logging.basicConfig(
        handlers=handlers,
        level=logging.DEBUG if options.verbose else logging.INFO,
        format="%(asctime)s pirsyncd[%(process)d] %(levelname)s %(message)s",
        force=True)


def daemonize():
    """ Classic unix double fork, so pirsyncd runs in background """
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    os.chdir("/")
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)


def stop_signal(signum, _frame):
    """ SIGTERM or SIGINT: stop the main loop """
    global RUNNING
    RUNNING = False


def pirsyncd(options):
    """ Start watching the source directory and run rsync on changes """
    fix_paths(options)
    errors = check_config(options)
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        print("Please check your configuration settings. Try: pirsyncd -h",
              file=sys.stderr)
        return 1

    # remove a stale pidfile from a crashed pirsyncd
    remove_pidfile(options.PIDFILE)

    command = rsync_command(options)

    # First watch, then rsync, so we do not miss any change in between
    print("pirsyncd is starting, watching " + options.SOURCE_PATH)
    inotify = Inotify()
    watch_tree(inotify, options.SOURCE_PATH, options)

    if options.FOREGROUND:
        print("pirsyncd runs in foreground (ctrl + c to stop the daemon)")
    else:
        print("pirsyncd runs in background, "
              "try: pirsyncd -p " + options.PIDFILE + " -k status")
        daemonize()

    setup_logging(options)
    signal.signal(signal.SIGTERM, stop_signal)
    signal.signal(signal.SIGINT, stop_signal)

    with open(options.PIDFILE, "w") as pfile:
        pfile.write(str(os.getpid()) + "\n")
    logging.info("pirsyncd %s started, %d directories watched",
                 VERSION, len(inotify.watches))
    try:
        return watch_loop(inotify, command, options)
    finally:
        remove_pidfile(options.PIDFILE)
        logging.info("pirsyncd stopped")


def main(argv=None):
    """ Read the user arguments and do what they ask """
    options = getarguments(argv)
    if options.examples:
        print(EXAMPLE_MSG)
        return 0
    if options.ACTION:
        options.PIDFILE = os.path.abspath(options.PIDFILE)
        return my_action(options)
    return pirsyncd(options)


if __name__ == "__main__":
    sys.exit(main())
